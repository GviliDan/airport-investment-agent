PORT=3001
LOG_LEVEL=info
# Ollama Cloud (https://ollama.com). Server-side only; leave blank to run without chat (health still works).
OLLAMA_API_KEY=
# Model is configuration only; no model name appears in code. Tested with gpt-oss:120b on Ollama Cloud.
# Other models may work, but must support reliable tool calling.
LLM_MODEL=gpt-oss:120b
LLM_TIMEOUT_MS=30000
AGENT_MAX_STEPS=6
# AeroDataBox via RapidAPI: route frequency and delay statistics. Server-side only; leave blank to run without it.
AERODATABOX_API_KEY=
